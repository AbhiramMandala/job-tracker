# Frontend config — copy to `.env` for local dev.
# NOTE: VITE_* vars are baked in at BUILD time. For production (Pages),
# set them in the Pages dashboard → Settings → Environment variables,
# then rebuild. They are never read at runtime.
# Local API (wrangler dev). Production: https://<worker>.<subdomain>.workers.dev
# VITE_API_URL=https://student-job-tracker-api.<your-subdomain>.workers.dev
VITE_API_URL=
# Local JobSetu. Production: https://<your-jobsetu-host> (no trailing slash).
# VITE_JOBSETU_URL=https://jobsetu.example.com
VITE_JOBSETU_URL=
