# Copy to worker/.dev.vars for local dev. NEVER commit real secrets.
SESSION_SECRET="dev-only-change-me-to-32-random-chars"
FRONTEND_ORIGIN="http://localhost:5173"
# SerpApi key for native Discover Jobs (server-side only, never commit a real key).
# SERPAPI_API_KEY=

# Copy to frontend/.env for local dev.
# VITE_API_URL= (empty = use Vite proxy to http://127.0.0.1:8787)
VITE_API_URL=
