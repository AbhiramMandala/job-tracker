# Local example configuration. NEVER commit real secrets.
#
# --- Cloudflare Tracker (Worker + frontend) ---
# Copy to worker/.dev.vars for local dev.
SESSION_SECRET="dev-only-change-me-to-32-random-chars"
FRONTEND_ORIGIN="http://localhost:5173"
# SerpApi key for native Discover Jobs (server-side only, never commit a real key).
# Consumed only by the Cloudflare Worker; unrelated to the JobSetu
# SERPAPI_KEY below — each service is configured separately.
# SERPAPI_API_KEY=

# Copy to frontend/.env for local dev.
# VITE_API_URL= (empty = use Vite proxy to http://127.0.0.1:8787)
VITE_API_URL=
#
# --- JobSetu (Python service, app/) ---
# Copy to .env at the repository root to run the FastAPI service locally.
# See "JobSetu service" in README.md for setup.
SERPAPI_KEY=
DATABASE_URL=sqlite:///./jobsetu.db
ENABLE_NEWS=false
ENABLE_MAPS=false
ENABLE_TRENDS=false
ENABLE_PDF=false
EVIDENCE_MAX_JOBS=5
NEWS_MAX_JOBS=3
